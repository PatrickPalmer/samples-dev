# Edge Deployment Environment Configuration
# Copy this to .env and fill in your values

# ==========================================
# Model Configuration (Centralized)
# ==========================================
# Target model selection: qwen3-1.7b-q4 (default), qwen3-1.7b-q4-xs, qwen3-1.7b
TARGET_MODEL=qwen3-1.7b-q4

# Model file paths (container paths)
MODEL_FILE=Qwen3-1.7B-Q4_K_M.gguf
QWEN_MODEL_PATH=/app/models/Qwen3-1.7B-Q4_K_M.gguf
WHISPER_MODEL_FILE=ggml-base.bin
WHISPER_MODEL_PATH=/app/models/ggml-base.bin

# Chat template for Qwen3 models
CHAT_TEMPLATE=chatml

# ==========================================
# Model Server Configuration
# ==========================================
# Local LlamaCpp server endpoint
LLAMACPP_URL=http://localhost:8080
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Bedrock model ID (if using AWS)
BEDROCK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0

# AWS Configuration (required for Bedrock)
# AWS_BEARER_TOKEN_BEDROCK=your_token_here
# AWS_REGION=us-east-1

# ==========================================
# Voice Input Configuration (Optional)
# ==========================================
# Only needed for local voice input on macOS/Linux
# FFMPEG_PATH=/path/to/ffmpeg-with-whisper
# WHISPER_MODEL_PATH=/path/to/whisper/models/ggml-base.bin
# DYLD_LIBRARY_PATH=/path/to/whisper/build/src (macOS only, auto-detected if not set)

# ==========================================
# Deployment Configuration
# ==========================================
# Deployment target: development, edge, automotive
DEPLOYMENT_TARGET=edge

# Enable API mode for containerized deployment
ENABLE_API=false

# ==========================================
# Performance Tuning (optimized for 1.7B 4-bit model)
# ==========================================
# Thread configuration
GGML_NTHREADS=4
OMP_NUM_THREADS=4

# Batch processing (optimized for speed)
LLAMA_BATCH_SIZE=512
LLAMA_UBATCH_SIZE=512
LLAMA_N_PARALLEL=1
LLAMA_CONTINUOUS_BATCHING=1

# ==========================================
# Resource Limits
# ==========================================
# Memory limit for container (e.g., 4g, 6g, 8g)
MEMORY_LIMIT=6g

# Context window size (reduced for better performance)
CONTEXT_WINDOW=20
LLAMA_CTX_SIZE=2048

# Maximum tokens per response
MAX_TOKENS=1024

# ==========================================
# Voice Configuration
# ==========================================
# Voice recording duration in seconds
VOICE_DURATION=10

# Voice sample rate in Hz
VOICE_SAMPLE_RATE=16000

# ==========================================
# Logging
# ==========================================
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ==========================================
# User Profiles (Optional)
# ==========================================
# Driver profile: guest, sarah, mike, david
DRIVER_PROFILE=guest

# ==========================================
# Development Settings
# ==========================================
# Enable rich UI for development (disable in production)
USE_RICH_UI=false

# Session ID for tracking
SESSION_ID=agentic-ai-edge-session